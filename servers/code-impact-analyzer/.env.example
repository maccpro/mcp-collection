# Code Impact Analyzer Configuration
CIA_MAX_SEARCH_DEPTH=3
CIA_FAIL_ON_CRITICAL=true
CIA_MAX_RISK_SCORE=25
CIA_EXCLUDE_PATHS=vendor,node_modules,storage,.git
CIA_DEFAULT_TEST_FRAMEWORK=pest

# AI Cognitive Reasoner (Optional - 100% Offline fallback if omitted)
CIA_AI_ENABLED=true
CIA_AI_PROVIDER=auto
CIA_API_KEY=
CIA_API_BASE=https://api.openai.com/v1
CIA_MODEL=gpt-4o-mini
CIA_THINKING=enabled

