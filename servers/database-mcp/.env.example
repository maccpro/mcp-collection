# Database MCP Configuration Template
# Database MCP runs 100% offline and deterministic with zero external dependencies.
# The following settings are optional overrides.

# Default Database Dialect: mariadb, mysql, or postgresql
DEFAULT_DATABASE_DIALECT=mariadb

# Default Migration Scope: standard or tenant
DEFAULT_MIGRATION_SCOPE=standard

# Optional AI API Key (Only needed if custom LLM conversational expansions are enabled)
DATABASE_API_KEY=
DATABASE_API_URL=https://api.openai.com/v1/chat/completions
DATABASE_MODEL=gpt-4o-mini
