# ==============================================================================
# Database MCP Server Configuration Template (@maccpro/database-mcp v1.2.3)
# ==============================================================================
# Database MCP runs 100% offline, deterministic, and zero-token with zero external npm dependencies.
# No live database connection credentials (passwords, auth tokens) are required.
# Copy this file to .env to override global defaults for code generation and analysis.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General & Database Engine Defaults
# ------------------------------------------------------------------------------
# Default target database dialect when omitted in MCP tool arguments.
# Supported dialects: mariadb, mysql, postgresql, sqlite
DB_DEFAULT_DIALECT=mariadb
DEFAULT_DATABASE_DIALECT=mariadb

# Default migration directory & scoping strategy.
# Supported scopes: standard (database/migrations/), tenant (database/migrations/tenant/)
DB_MIGRATION_SCOPE=standard
DEFAULT_MIGRATION_SCOPE=standard

# Default primary key strategy for new tables and ER schema designs.
# Supported strategies: id (auto-increment bigInteger), uuid, ulid
DB_DEFAULT_ID_STRATEGY=id

# Default application database name for backup runbooks and connection poolers
DB_DEFAULT_DATABASE_NAME=app_production

# Default staging/testing database name for GDPR data sanitization runbooks
DB_DEFAULT_STAGING_DB_NAME=app_staging

# ------------------------------------------------------------------------------
# 2. Pre-Commit Quality Gate & Zero-Downtime Migration Auditing
# ------------------------------------------------------------------------------
# Default workspace/repository path to scan for db_quality_gate.
# If left commented or empty, defaults to current working directory (process.cwd()).
# DB_WORKSPACE_PATH=D:/mcp-collection

# Estimated table row count threshold to trigger lock audit warnings (default: 100000)
DB_LOCK_AUDIT_ROW_THRESHOLD=100000

# ------------------------------------------------------------------------------
# 3. Production Hardware Sizing & Linux Sysctl Configuration (db_tune_server_config)
# ------------------------------------------------------------------------------
# Total server RAM available to the database in Gigabytes (default: 4)
DB_SERVER_RAM_GB=4

# Server vCPU / CPU core count (default: 4)
DB_SERVER_VCPU=4

# Underlying disk storage architecture: nvme, ssd, hdd (default: nvme)
DB_SERVER_DISK_TYPE=nvme

# Workload profile: oltp (high concurrency web apps), dw (data warehouse / reporting), mixed
DB_SERVER_WORKLOAD=oltp

# Server hosting environment: dedicated (bare-metal/dedicated VPS), shared (container/shared VPS)
DB_SERVER_ENVIRONMENT=dedicated

# ------------------------------------------------------------------------------
# 4. Connection Pooling Configuration (db_tune_connection_pooler)
# ------------------------------------------------------------------------------
# Target connection pooler system: pgbouncer (PostgreSQL), proxysql (MariaDB/MySQL)
DB_DEFAULT_POOLER=pgbouncer

# Maximum expected concurrent client connections (default: 2000)
DB_POOLER_MAX_CLIENT_CONNECTIONS=2000

# Target database server host / IP for connection pooler upstream routing
DB_TARGET_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 5. Model Factory, Seeder & Table Partitioning Defaults
# ------------------------------------------------------------------------------
# Default record count for Model Factory & Seeder generator (db_generate_seeder_factory)
DB_SEEDER_RECORD_COUNT=50

# Default table partitioning strategy: range (date/timestamp bucketed), list (tenant/region)
DB_PARTITION_DEFAULT_TYPE=range

# Default partition bucket interval: monthly, yearly
DB_PARTITION_DEFAULT_INTERVAL=monthly
