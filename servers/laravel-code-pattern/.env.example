# Laravel Code Pattern MCP Individual Configuration
# Copy this file to .env and configure your individual settings

# Primary Reviewer: Xiaomi MiMo (or custom OpenAI-compatible provider)
LARAVEL_PATTERN_API_KEY=your_mimo_api_key_here
LARAVEL_PATTERN_API_URL=https://api.xiaomimimo.com/v1/chat/completions
LARAVEL_PATTERN_MODEL=mimo-v2.6

# Fallback Reviewer: DeepSeek (or secondary provider)
LARAVEL_PATTERN_FALLBACK_API_KEY=your_deepseek_api_key_here
LARAVEL_PATTERN_FALLBACK_API_URL=https://api.deepseek.com/v1/chat/completions
LARAVEL_PATTERN_FALLBACK_MODEL=deepseek-v4-flash
