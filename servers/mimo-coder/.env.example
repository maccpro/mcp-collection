# Xiaomi MiMo MCP Configuration Template
# Copy this file to .env and configure your local settings

# Primary: Xiaomi MiMo API Key
MIMO_API_KEY=your_actual_mimo_api_key_here

# Primary: Custom API URL (defaults to Xiaomi MiMo v1 chat completions)
MIMO_API_URL=https://api.xiaomimimo.com/v1/chat/completions

# Primary: Model Name (defaults to mimo-v2.6-pro)
MIMO_MODEL=mimo-v2.6-pro

# Primary: Deep Thinking / Reasoning Mode (enabled or disabled, default: enabled)
MIMO_THINKING=enabled

# Fallback: Secondary Provider (e.g. DeepSeek or OpenAI-compatible)
# Automatically called if primary MiMo API request fails or is rate-limited
MIMO_FALLBACK_API_KEY=your_fallback_api_key_here
MIMO_FALLBACK_API_URL=https://api.deepseek.com/v1/chat/completions
MIMO_FALLBACK_MODEL=deepseek-v4-flash
