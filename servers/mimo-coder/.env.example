# Xiaomi MiMo MCP Configuration Template
# Copy this or configure directly inside your client's mcp_config.json

# Required: Your Xiaomi MiMo API Key
MIMO_API_KEY=your_actual_mimo_api_key_here

# Optional: Custom API URL (defaults to Xiaomi MiMo v1 chat completions)
MIMO_API_URL=https://api.xiaomimimo.com/v1/chat/completions

# Optional: Model Name (defaults to mimo-v2.6-pro)
MIMO_MODEL=mimo-v2.6-pro

# Optional: Deep Thinking / Reasoning Mode (enabled or disabled, default: disabled)
MIMO_THINKING=disabled
